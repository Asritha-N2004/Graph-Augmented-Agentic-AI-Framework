# Backend: variables must be exported by your shell, or loaded with uvicorn --env-file.
DATABASE_URL=sqlite:///backend/cirp.db
CORS_ORIGINS=http://localhost:3000
ENABLE_TRAINING_API=false
# Optional OpenAI-compatible provider; deterministic analytics work without this key.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
# Frontend: copy this variable into frontend/.env.local before building.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Server-only frontend settings for deployment. Never prefix these with NEXT_PUBLIC_.
BACKEND_URL=http://localhost:8010
# Set the same random service key in Vercel and Render.
BACKEND_API_KEY=
AUTH_EMAIL=
AUTH_PASSWORD=
# At least 32 random characters, configured only on the frontend server.
AUTH_SECRET=
